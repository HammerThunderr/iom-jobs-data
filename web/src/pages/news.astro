---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import Off from '../components/Off.astro';
import { news, NEWS_COLOURS } from '../lib/news';
import { featureOff } from '../lib/data';
import { excerpt, fmtDateTime } from '../lib/format';

const off = featureOff('news');
const { items, generated } = await news();
const sources = [...new Set(items.map((n) => n.source))].sort();
---
<Layout title="Isle of Man News" description="Latest Isle of Man news headlines from Manx Radio, Three FM and more, in one feed." section="news">
  <PageHead title="News" sub="Latest Isle of Man headlines from local newsrooms" icon="newspaper">
    <span slot="meta" id="news-updated">{generated && `Updated ${fmtDateTime(generated)}`}</span>
  </PageHead>
  <div class="wrap">
    {off ? <Off message={off} /> : (
      <>
        <div class="toolbar">
          <div class="search"><Icon name="search" /><input id="q" type="search" placeholder="Search headlines" aria-label="Search headlines" /></div>
        </div>
        <div class="chips" id="chips">
          <button class="chip" type="button" data-value="all" aria-pressed="true">All</button>
          {sources.map((s) => <button class="chip" type="button" data-value={s} aria-pressed="false">{s}</button>)}
        </div>
        <p class="count-line"><span id="count">{items.length}</span> stories</p>
        <div class="grid lg" id="list">
          {items.map((n) => (
            <a class="card news-card" href={n.link} target="_blank" rel="noopener" data-source={n.source} data-search={`${n.title} ${n.summary} ${n.source}`.toLowerCase()}>
              {n.image && <img class="thumb" src={n.image} alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />}
              <span class="tag" style={`background:${NEWS_COLOURS[n.source] ?? '#607D8B'};color:#fff`}>{n.source}</span>
              <h3 style="margin-top:8px">{n.title}</h3>
              {n.summary && n.summary !== n.title && <p class="small muted clamp-3">{excerpt(n.summary, 220)}</p>}
              <p class="tiny muted mb0"><time datetime={n.published}>{fmtDateTime(n.published)}</time></p>
            </a>
          ))}
        </div>
        <p class="empty" id="empty" hidden>No stories match.</p>
        <p class="source">Headlines link to the original publishers. Manx One shows the headline and summary only.</p>
      </>
    )}
  </div>
</Layout>

<script>
  import { getJson, esc, wireFilter, $$ } from '../lib/client';
  const COLOURS: Record<string, string> = { 'Manx Radio': '#C62828', 'Three FM': '#1565C0', 'Energy FM': '#EF6C00', 'Isle of Man Government': '#2E7D32', 'Google News': '#455A64' };
  const list = document.getElementById('list');
  const wire = () =>
    wireFilter({
      input: document.getElementById('q') as HTMLInputElement,
      items: $$('#list > a'),
      chips: $$('#chips .chip'),
      chipAttr: 'data-source',
      count: document.getElementById('count'),
      empty: document.getElementById('empty'),
    });
  if (list) {
    wire();
    // Refresh from the live feed if it is newer than this build.
    getJson<any>('https://raw.githubusercontent.com/HammerThunderr/IOM_OPEN_DATA/main/data/news.json')
      .then((d) => {
        const items = (d.items || []).filter((n: any) => n.title && /^https?:/.test(n.link)).sort((a: any, b: any) => String(b.published).localeCompare(String(a.published)));
        const first = list.querySelector<HTMLAnchorElement>('a')?.href;
        if (!items.length || items[0].link === first) return;
        list.innerHTML = items
          .map((n: any) => {
            const when = new Date(n.published);
            const img = /^https?:/.test(n.image || '') ? `<img class="thumb" src="${esc(n.image)}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">` : '';
            const sum = n.summary && n.summary !== n.title ? `<p class="small muted clamp-3">${esc(String(n.summary).replace(/<[^>]+>/g, '').slice(0, 220))}</p>` : '';
            return `<a class="card news-card" href="${esc(n.link)}" target="_blank" rel="noopener" data-source="${esc(n.source)}" data-search="${esc(`${n.title} ${n.summary} ${n.source}`.toLowerCase())}">${img}<span class="tag" style="background:${COLOURS[n.source] ?? '#607D8B'};color:#fff">${esc(n.source)}</span><h3 style="margin-top:8px">${esc(n.title)}</h3>${sum}<p class="tiny muted mb0">${when.toLocaleString('en-GB', { timeZone: 'Europe/London', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</p></a>`;
          })
          .join('');
        document.getElementById('news-updated')!.textContent = `Updated ${new Date(d.generated_at).toLocaleString('en-GB', { timeZone: 'Europe/London', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}`;
        wire();
      })
      .catch(() => {});
  }
</script>
