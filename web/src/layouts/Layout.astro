---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { sections, section as sectionByKey, GROUPS } from '../lib/nav';
import { features, load } from '../lib/data';
import { ICONS } from '../lib/icons';

interface Props {
  title: string;
  description?: string;
  section?: string;
  image?: string;
  noindex?: boolean;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description = 'Everything Isle of Man in one place: jobs, property, news, weather, travel, events and local services.', section, image, noindex = false, jsonld } = Astro.props;

const all = sections(features());
const current = section ? sectionByKey(section) : null;
const accent = current?.color ?? '#cf1020';
const banner = load<any>('features.json')?.banner;
const fullTitle = title === 'Manx One' ? 'Manx One — Isle of Man in one place' : `${title} | Manx One`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image || new URL('/icon-512.png', Astro.site).toString();
const iconUrl = `https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0..1,0&icon_names=${[...ICONS].sort().join(',')}&display=block`;
const quick = ['news', 'jobs', 'property', 'events', 'weather', 'bus_times', 'ferry', 'flights'].map(sectionByKey).filter((s) => all.includes(s));
const groups = Object.entries(GROUPS).map(([g, label]) => ({ label, items: all.filter((s) => s.group === g) }));
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#cf1020" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Manx One" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href={iconUrl} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <script is:inline>
      try {
        const t = localStorage.getItem('mx:theme');
        if (t === '"dark"' || t === '"light"') document.documentElement.dataset.theme = JSON.parse(t);
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body style={`--accent:${accent}`}>
    <a class="skip" href="#main">Skip to content</a>
    {banner?.show && banner?.text && (
      <div class="banner">{banner.url ? <a href={banner.url} rel="noopener">{banner.text}</a> : banner.text}</div>
    )}
    <header class="site-head">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Manx One home">
          <img src="/icon.svg" alt="" width="34" height="34" />
          <span>Manx <b>One</b></span>
        </a>
        <nav class="quick" aria-label="Main">
          {quick.map((s) => (
            <a href={s.href} aria-current={current?.key === s.key ? 'page' : undefined}>{s.title}</a>
          ))}
        </nav>
        <div class="head-actions">
          <a class="icon-btn sos" href="/emergency/" aria-label="Emergency numbers"><Icon name="emergency" /><span class="lbl">Emergency</span></a>
          <button class="icon-btn" id="theme-btn" type="button" aria-label="Switch light or dark mode"><Icon name="dark_mode" /></button>
          <button class="icon-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="menu-panel"><Icon name="menu" /><span class="lbl">All sections</span></button>
        </div>
      </div>
    </header>
    <div class="menu-panel" id="menu-panel" hidden>
      <div class="wrap">
        <div class="search search-row">
          <Icon name="search" />
          <input id="menu-search" type="search" placeholder="Find a section…" aria-label="Find a section" autocomplete="off" />
        </div>
        <div class="menu-groups">
          {groups.map((g) => (
            <section>
              <h2>{g.label}</h2>
              {g.items.map((s) => (
                <a href={s.href} data-search={`${s.title} ${s.subtitle}`.toLowerCase()}>
                  <span class="dot" style={`background:${s.color}`}><Icon name={s.icon} /></span>
                  <span>{s.title}<br /><span class="muted tiny">{s.subtitle}</span></span>
                </a>
              ))}
            </section>
          ))}
        </div>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a class="brand" href="/"><img src="/icon.svg" alt="" width="34" height="34" /><span>Manx <b>One</b></span></a>
            <p class="muted small" style="margin-top:10px">Isle of Man jobs, property, news, travel and local services in one place. Built on public sources and checked daily.</p>
            <p><a class="btn sm" href="https://play.google.com/store/apps/details?id=com.manxone.app" rel="noopener" target="_blank"><Icon name="android" /> Get the Android app</a></p>
          </div>
          {groups.map((g) => (
            <div>
              <h2>{g.label}</h2>
              <ul>{g.items.map((s) => <li><a href={s.href}>{s.title}</a></li>)}</ul>
            </div>
          ))}
        </div>
        <div class="foot-legal">
          <span>© {new Date().getFullYear()} Manx One by Hammer Labs. Not affiliated with the Isle of Man Government.</span>
          <span><a href="/about/">About & sources</a> · <a href="https://hammerthunderr.github.io/iom-jobs-data/privacy.html" rel="noopener">Privacy</a> · <a href="mailto:hammerpunch786@gmail.com?subject=Manx%20One%20website">Contact</a></span>
        </div>
      </div>
    </footer>

    <script>
      import { store } from '../lib/client';
      const menuBtn = document.getElementById('menu-btn')!;
      const panel = document.getElementById('menu-panel')!;
      const search = document.getElementById('menu-search') as HTMLInputElement;
      const setMenu = (open: boolean) => {
        panel.hidden = !open;
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.querySelector('.ms')!.textContent = open ? 'close' : 'menu';
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) setTimeout(() => search.focus(), 30);
      };
      menuBtn.addEventListener('click', () => setMenu(panel.hidden));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !panel.hidden) setMenu(false);
        if (e.key === '/' && panel.hidden && !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement)) {
          e.preventDefault();
          setMenu(true);
        }
      });
      search.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        panel.querySelectorAll<HTMLElement>('.menu-groups a').forEach((a) => (a.hidden = !!q && !a.dataset.search!.includes(q)));
        panel.querySelectorAll<HTMLElement>('.menu-groups section').forEach((s) => (s.hidden = !s.querySelector('a:not([hidden])')));
      });
      search.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const first = panel.querySelector<HTMLAnchorElement>('.menu-groups a:not([hidden])');
          if (first) location.href = first.href;
        }
      });

      const themeBtn = document.getElementById('theme-btn')!;
      const isDark = () => {
        const t = document.documentElement.dataset.theme;
        return t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      };
      const paint = () => (themeBtn.querySelector('.ms')!.textContent = isDark() ? 'light_mode' : 'dark_mode');
      paint();
      themeBtn.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        store.set('theme', next);
        paint();
      });
    </script>
  </body>
</html>
